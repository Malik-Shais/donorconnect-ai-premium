# Copy to .env.local (never commit it). `npm run db:up` generates a working local one for you.
# Only these two values are read by the Next.js app, and both are safe to be public (RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: absolute site URL used in password-reset links (otherwise derived from the request host).
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# NEVER put the Supabase service-role key or database password in .env.local or any NEXT_PUBLIC_ variable.
# The service-role key is used only by scripts/seed-dev.mjs (read from supabase/.env.dev, local development only).
# Tests read TEST_DATABASE_URL and MAILPIT_URL from .env.test.local (generated by `npm run db:up`).
