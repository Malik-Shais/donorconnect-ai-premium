# Copy to .env.local (never commit it). `npm run db:up` generates a working local one for you.
# Only these two values are read by the Next.js app, and both are safe to be public (RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: absolute site URL used in password-reset links (otherwise derived from the request host).
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# NEVER put the Supabase service-role key or database password in .env.local or any NEXT_PUBLIC_ variable.
# The service-role key is used only by scripts/seed-dev.mjs (read from supabase/.env.dev, local development only).
# Tests read TEST_DATABASE_URL and MAILPIT_URL from .env.test.local (generated by `npm run db:up`).

# ---- Stage 5: AI assistant (server-side only) ----
# Get a free-tier key at https://aistudio.google.com/apikey . It is read ONLY by the Next.js server (src/lib/ai/provider.ts).
# Never prefix it with NEXT_PUBLIC_, never commit it. Without it the assistant shows "not configured" and the reviewed quick answers still work.
# GEMINI_API_KEY=
# Optional: model id available to your key (default gemini-3.6-flash). Check Google's current model list before changing.
# GEMINI_MODEL=
# TEST-ONLY deterministic mock (needs BOTH flags; used by Playwright, never set in a real deployment):
# AI_PROVIDER=mock
# DC_ALLOW_AI_MOCK=1
