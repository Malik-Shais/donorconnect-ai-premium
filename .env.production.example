# Production environment variables (set them in the Vercel project settings; NEVER commit a filled copy). See docs/DEPLOYMENT.md.
# ---- public (safe to expose; RLS protects the data) ----
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>
NEXT_PUBLIC_SITE_URL=https://<your-domain>
# ---- server-only secrets (mark as Sensitive in Vercel; never prefix with NEXT_PUBLIC_) ----
RATE_LIMIT_SECRET=<32+ random bytes, hex>        # its SHA-256 goes into public.app_settings (docs/DEPLOYMENT.md step 5); without it the limiter fails closed
GEMINI_API_KEY=<free-tier key, optional>         # without it the assistant shows "not configured"; reviewed quick answers still work
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_TIMEOUT_MS=25000
# ---- NEVER set in production ----
# AI_PROVIDER / DC_ALLOW_AI_MOCK   (test-only mock)       SUPABASE_SERVICE_ROLE_KEY   (not used by the web app)
