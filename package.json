{
  "name": "donorconnect-ai-premium",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "next build && CHROMIUM_PATH=/opt/pw-browsers/chromium playwright test",
    "icons": "node scripts/make-icons.mjs",
    "db:up": "node scripts/stack.mjs up",
    "db:down": "node scripts/stack.mjs down",
    "db:reset": "node scripts/stack.mjs reset",
    "db:migrate": "node scripts/stack.mjs migrate",
    "db:seed": "node scripts/seed-dev.mjs",
    "test:db": "vitest run tests/db",
    "email:once": "node scripts/email-worker.mjs --once",
    "email:worker": "node scripts/email-worker.mjs",
    "verify:fresh": "node scripts/verify-fresh.mjs",
    "test:live": "DC_LIVE=1 CHROMIUM_PATH=/opt/pw-browsers/chromium playwright test live --project=desktop",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm test && npm run scan:secrets",
    "load:test": "node scripts/load-test.mjs"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "next": "16.4.5",
    "nodemailer": "^10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "^31.0.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
