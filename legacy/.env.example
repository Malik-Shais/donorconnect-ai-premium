# Copy to .env (never commit .env). All values optional.
DC_DB_PATH=data/donorconnect.db
# Set to 1 when serving over HTTPS so the session cookie is Secure.
DC_COOKIE_SECURE=0
# Free-tier Gemini key from https://aistudio.google.com/apikey (leave empty to use the offline assistant).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
